# PicHost — Environment Variables
# All env vars use PICHOST_ prefix. Nested config keys use `__` (double
# underscore) for nesting — e.g. PICHOST_AUTH__JWT_SECRET → auth.jwt_secret.
# Single `_` still works for 2-segment keys (PICHOST_DATABASE_URL → database.url).
PICHOST_AUTH__JWT_SECRET=your-secret-at-least-32-bytes
PICHOST_SERVER__PUBLIC_URL=http://localhost
# PICHOST_AUTH__OAUTH__GITHUB_CLIENT_ID=
# PICHOST_AUTH__OAUTH__GITHUB_CLIENT_SECRET=
# PICHOST_AUTH__OAUTH__GOOGLE_CLIENT_ID=
# PICHOST_AUTH__OAUTH__GOOGLE_CLIENT_SECRET=

# Database
# PICHOST_DATABASE_MODE=postgres     # postgres|sqlite (sqlite = lightweight lite mode, no Redis needed)
PICHOST_DATABASE_URL=postgresql://user:password@localhost:5432/pichost

# Redis (not needed in sqlite mode)
PICHOST_REDIS_URL=redis://localhost:6379

# Storage (local)
PICHOST_STORAGE__LOCAL_BASE_PATH=./storage-local

# Storage (S3/RustFS, optional)
# PICHOST_STORAGE__RUSTFS__ENDPOINT=https://s3.example.com
# PICHOST_STORAGE__RUSTFS__BUCKET=pichost
# PICHOST_STORAGE__RUSTFS__REGION=us-east-1
# PICHOST_STORAGE__RUSTFS__ACCESS_KEY=your-access-key
# PICHOST_STORAGE__RUSTFS__SECRET_KEY=your-secret-key

# Git storage (optional)
# PICHOST_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encoded-key
# PICHOST_STORAGE__MAX_USER_CONFIGS=5

# Docker helper (sqlx CLI, not consumed by app)
DATABASE_URL=postgresql://user:password@localhost:5432/pichost
# Rate limits (requests per 60s window per policy). Tune for deployments;
# E2E tests raise these so the suite is not throttled.
# PICHOST_RATE_LIMIT__AUTH_MAX=5
# PICHOST_RATE_LIMIT__UPLOAD_MAX=30
# PICHOST_RATE_LIMIT__GENERAL_MAX=60
# PICHOST_RATE_LIMIT__PUBLIC_MAX=200

# i18n
PICHOST_I18N_LANGUAGE=en            # Default UI language: en|zh-CN
# PICHOST_I18N_LOCALES_DIR=          # Optional external locale override directory
